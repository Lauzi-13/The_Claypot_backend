# Copy this file to .env and fill in the real values. .env is gitignored —
# never commit real secrets.

# Get this from your Postgres provider (e.g. Neon, Railway, Supabase, or a
# local Postgres install). Example shape:
# postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/claypot?sslmode=require"

PORT=4000

# Same secrets that used to live in plain text in site/store.js — now they
# stay on the server and are never shipped to the browser.
CALLMEBOT_API_KEY=
RESTAURANT_WHATSAPP=+260974671924
DELIVERY_WHATSAPP=+260974671924
MTN_MOMO_NUMBER=
AIRTEL_MONEY_NUMBER=0974671924
